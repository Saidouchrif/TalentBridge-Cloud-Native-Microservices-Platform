# Fichier .env.example - Copier en .env et customiser

# ========================
# Node Environment
# ========================
NODE_ENV=development
PORT=5003

# ========================
# PostgreSQL Configuration
# ========================
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=notifications_db

# Pour tests SQLite en mémoire:
# DB_DIALECT=sqlite
# SQLITE_STORAGE=:memory:

# ========================
# Security & JWT
# ========================
JWT_SECRET=change-me-in-production-use-strong-key-32chars
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# ========================
# Email Configuration
# ========================
# Options: 'test' (Ethereal dev), 'smtp' (production)
EMAIL_PROVIDER=test

# SMTP Configuration (si EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=no-reply@talentbridge.com

# ========================
# Integration Services
# ========================
NOTIFICATIONS_SERVICE_URL=http://localhost:5003/api/notifications
SERVICE_JWT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ========================
# Feature Flags
# ========================
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_INAPP_NOTIFICATIONS=true

# ========================
# Logging
# ========================
LOG_LEVEL=debug
