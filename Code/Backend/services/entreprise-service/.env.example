# Port sur lequel le microservice expose ses endpoints REST
PORT=5002

# Connexion PostgreSQL (en local via docker-compose)
DB_HOST=entreprise-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=entreprise_db

# Secret JWT commun avec le service d'authentification
JWT_SECRET=supersecret

# Autoriser CORS (à adapter selon votre API Gateway / domaine)
CORS_ORIGIN=*

