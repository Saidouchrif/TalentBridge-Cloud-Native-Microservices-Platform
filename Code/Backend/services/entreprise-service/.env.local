# Configuration alternative pour PostgreSQL local (sans Docker)

# Port du service
PORT=5002

# Connexion PostgreSQL locale (installation directe)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=entreprise_db

# Forcer PostgreSQL
DB_DIALECT=postgres

# JWT
JWT_SECRET=supersecret

# CORS
CORS_ORIGIN=*
