# Shared Docker Compose variables for TalentBridge
# Copy this file to Dev/.env (same folder as docker-compose.yaml). Docker Compose
# injecte ces variables dans docker-compose.yaml ; sans Dev/.env, ${POSTGRES_*}
# restent vides et les services Node plantent (PostgreSQL: no user name specified).
# Remplacez chaque placeholder par vos valeurs locales.

POSTGRES_USER=talentbridge_user
POSTGRES_PASSWORD=change_me_postgres_password
PGADMIN_DEFAULT_EMAIL=admin@talentbridge.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

JWT_SECRET=change_me_shared_jwt_secret
JWT_ALGORITHM=HS256

SERVICE_INTERNAL_TOKEN=change_me_service_internal_token
NOTIFICATION_INTERNAL_TOKEN=change_me_notification_internal_token
MATCHING_SERVICE_TOKEN=change_me_matching_service_token

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change_me_smtp_user@example.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM=change_me_smtp_from@example.com

OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
