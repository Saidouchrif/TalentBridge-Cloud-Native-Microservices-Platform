# Meme cle que Auth-User-service (validation JWT utilisateur)
SECRET_KEY=super_secret_key_123456
REFRESH_SECRET_KEY=super_refresh_secret_key_123456
ALGORITHM=HS256
ENV=docker
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30
VERIFY_EMAIL_TOKEN_EXPIRE_MINUTES=1440
RESET_PASSWORD_URL=http://localhost:5173/reset-password
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
REQUIRE_EMAIL_VERIFICATION_ON_LOGIN=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_compte@gmail.com
SMTP_PASSWORD=mot_de_passe_application_gmail
SMTP_FROM=votre_compte@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

PORT=8005
DATABASE_URL=postgresql://talentbridge_user:talentbridge_password@postgres:5432/notification_db

# URL du service Auth (liste utilisateurs / detail, jeton admin)
AUTH_SERVICE_URL=http://auth-user-service:8000
# Jeton d'acces (Bearer) d'un compte admin Auth — necessaire pour diffuser une nouvelle offre a tous les etudiants
AUTH_SERVICE_ADMIN_TOKEN=

# Partage avec offres-service et candidature-service (header X-Service-Token)
NOTIFICATION_INTERNAL_TOKEN=talentbridge_notify_internal
